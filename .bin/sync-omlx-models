#!/usr/bin/env python3
"""Sync omlx's live model list into opencode.jsonc and pi's models.json.

Source of truth: GET {OMLX_BASE}/models. Adds new models, removes models
omlx no longer serves, leaves untouched fields (display name, cost, etc.)
alone for models that already exist in each config.
"""
import json
import os
import re
import sys
import urllib.request


def load_jsonc(path):
    with open(path) as f:
        text = f.read()
    # tolerate trailing commas (real jsonc comment stripping isn't needed here
    # since this file has none outside of string values)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return json.loads(text)

OMLX_BASE = "http://localhost:7100/v1"
OMLX_KEY = "omlx-f0dl0v4d6ed1fq76"
OPENCODE_CONFIG = os.path.expanduser("~/.config/opencode/opencode.jsonc")
PI_MODELS = os.path.expanduser("~/.pi/agent/models.json")


def fetch_omlx_models():
    req = urllib.request.Request(
        f"{OMLX_BASE}/models",
        headers={"Authorization": f"Bearer {OMLX_KEY}"},
    )
    with urllib.request.urlopen(req, timeout=5) as resp:
        data = json.load(resp)
    return {m["id"]: m for m in data["data"]}


def sync_opencode(live_models):
    config = load_jsonc(OPENCODE_CONFIG)

    existing = config["provider"]["omlx"]["models"]
    changed = False

    for model_id in list(existing):
        if model_id not in live_models:
            del existing[model_id]
            changed = True
            print(f"opencode: removed {model_id}")

    for model_id in live_models:
        if model_id not in existing:
            existing[model_id] = {
                "name": model_id,
                "modalities": {"input": ["text", "image"], "output": ["text"]},
            }
            changed = True
            print(f"opencode: added {model_id}")

    if changed:
        with open(OPENCODE_CONFIG, "w") as f:
            json.dump(config, f, indent=2)
            f.write("\n")
    return changed


def sync_pi(live_models):
    with open(PI_MODELS) as f:
        config = json.load(f)

    models = config["providers"]["omlx"]["models"]
    existing_ids = {m["id"] for m in models}
    changed = False

    kept = [m for m in models if m["id"] in live_models]
    if len(kept) != len(models):
        for m in models:
            if m["id"] not in live_models:
                print(f"pi: removed {m['id']}")
        changed = True

    for model_id, meta in live_models.items():
        if model_id not in existing_ids:
            kept.append({
                "id": model_id,
                "name": model_id,
                "reasoning": False,
                "input": ["text", "image"],
                "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                "contextWindow": meta.get("max_model_len", 262144),
                "maxTokens": 32768,
            })
            changed = True
            print(f"pi: added {model_id}")

    if changed:
        config["providers"]["omlx"]["models"] = kept
        with open(PI_MODELS, "w") as f:
            json.dump(config, f, indent=2)
            f.write("\n")
    return changed


def main():
    try:
        live_models = fetch_omlx_models()
    except Exception as e:
        print(f"could not reach omlx at {OMLX_BASE}: {e}", file=sys.stderr)
        sys.exit(1)

    changed = False
    changed |= sync_opencode(live_models)
    changed |= sync_pi(live_models)

    if not changed:
        print("already in sync")


if __name__ == "__main__":
    main()
